        if c and item:IsA("Tool") then
            seen[item] = true
            attachHighlight(item, c, c, 0.5, espTrackers.Items)
        end
    end
    for m in pairs(espTrackers.Items) do
        if not seen[m] or not m.Parent then detachHighlight(m, espTrackers.Items) end
    end
end

local function clearKillerESP()
    for m in pairs(espTrackers.Killers) do detachHighlight(m, espTrackers.Killers) end
end
local function clearSurvivorESP()
    for m in pairs(espTrackers.Survivors) do detachHighlight(m, espTrackers.Survivors) end
end
local function clearGeneratorESP()
    for m in pairs(espTrackers.Generators) do detachHighlight(m, espTrackers.Generators) end
end
local function clearItemESP()
    for m in pairs(espTrackers.Items) do detachHighlight(m, espTrackers.Items) end
end

