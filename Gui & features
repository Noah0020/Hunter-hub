HDT = {
    Enabled       = false,
    AutoTrigger   = true,          -- fires on own block anim playing
    Speed         = 10,
    Delay         = 0,
    StopDistance  = 2,
    SafetyTimeout = 0.4,
    _dragId       = 0,
    _dragging     = false,
    _conn         = nil,
    _bv           = nil,
    _saved        = nil,
    _lastFire     = 0,
    _fireDebounce = 0.5,
}

-- Guest1337 ability block anims — HDT fires the moment one of these plays
local OWN_BLOCK_ANIMS_SET = {
    ["96959123077498"]  = true,
    ["90970641235403"]  = true,
    ["72722244508749"]  = true,
}

local function nearestKillerPart()
    local myRoot = getMyRoot()
    if not myRoot or not KillersFolder then return nil end
    local best, bestDist = nil, math.huge
    for _, k in ipairs(KillersFolder:GetChildren()) do
        if k:IsA("Model") then
            local hrp = k:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < bestDist then best, bestDist = hrp, d end
            end
        end
    end
    return best
end

local function startDrag(targetPart)
    if not targetPart or not targetPart.Parent then return end
    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    -- Cancel any existing drag first
    HDT._dragId += 1
    local myId = HDT._dragId

    if HDT._conn then HDT._conn:Disconnect() HDT._conn = nil end
    if HDT._bv and HDT._bv.Parent then HDT._bv:Destroy() end
    HDT._bv = nil

    HDT._dragging = true
    local saved = {
        walk          = humanoid.WalkSpeed,
        jump          = humanoid.JumpPower,
        platformStand = humanoid.PlatformStand,
        autoRotate    = humanoid.AutoRotate,
    }
    HDT._saved = saved

    humanoid.WalkSpeed     = 0
    humanoid.JumpPower     = 0
    humanoid.PlatformStand = false
    humanoid.AutoRotate    = false

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(100000, 0, 100000)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp
    HDT._bv = bv

    local function cleanup()
        -- Only the current drag is allowed to clean up shared state
        if HDT._dragId ~= myId then return end
        HDT._dragging = false
        if HDT._conn then HDT._conn:Disconnect() HDT._conn = nil end
        if bv and bv.Parent then bv:Destroy() end
        if humanoid and humanoid.Parent then
            humanoid.WalkSpeed     = saved.walk
            humanoid.JumpPower     = saved.jump
            humanoid.PlatformStand = saved.platformStand
            humanoid.AutoRotate    = saved.autoRotate
        end
        HDT._bv = nil
        HDT._saved = nil
    end

    HDT._conn = RunService.Heartbeat:Connect(function()
        if HDT._dragId ~= myId then
            if HDT._conn then HDT._conn:Disconnect() HDT._conn = nil end
            return
        end
        if not (char and char.Parent and targetPart and targetPart.Parent) then
            cleanup()
            return
        end
        local myPos = hrp.Position
        local tgtPos = targetPart.Position
        local dx = tgtPos.X - myPos.X
        local dz = tgtPos.Z - myPos.Z
        local horizSq = dx*dx + dz*dz
        if horizSq > 1.0E-4 then
            local dist = math.sqrt(horizSq)
            bv.Velocity = Vector3.new((dx / dist) * HDT.Speed, 0, (dz / dist) * HDT.Speed)
            hrp.CFrame = CFrame.lookAt(myPos, Vector3.new(tgtPos.X, myPos.Y, tgtPos.Z))
        else
            bv.Velocity = Vector3.zero
        end
        if (tgtPos - myPos).Magnitude <= HDT.StopDistance then
            cleanup()
        end
    end)

    task.delay(HDT.SafetyTimeout, function()
        -- Only trip if this drag is still the active one
        if HDT._dragId == myId and HDT._dragging then
            cleanup()
        end
    end)
end

function HDT.TriggerFromAutoBlock()
    if not HDT.Enabled then return end
    if tick() - HDT._lastFire < HDT._fireDebounce then return end
    if HDT._dragging then return end
    HDT._lastFire = tick()
    local target = nearestKillerPart()
    if not target then return end
    if HDT.Delay > 0 then
        task.delay(HDT.Delay, function() startDrag(target) end)
    else
        startDrag(target)
    end
end
HDT.Trigger = HDT.TriggerFromAutoBlock

lp.CharacterAdded:Connect(function()
    HDT._dragId += 1   -- invalidate any pending cleanup from old drag
    HDT._dragging = false
    if HDT._conn then HDT._conn:Disconnect() HDT._conn = nil end
    if HDT._bv and HDT._bv.Parent then HDT._bv:Destroy() end
    HDT._bv = nil
    HDT._saved = nil
end)

-- Fire HDT the moment your own block anim plays. This is the ONLY HDT path now.
local hdtAnimatorConn = nil
local function hookHDTAnimator()
    if hdtAnimatorConn then hdtAnimatorConn:Disconnect() hdtAnimatorConn = nil end
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    hdtAnimatorConn = animator.AnimationPlayed:Connect(function(track)
        if not HDT.Enabled or not HDT.AutoTrigger then return end
        local id = track.Animation and tostring(track.Animation.AnimationId):match("(%d+)")
        if not id or not OWN_BLOCK_ANIMS_SET[id] then return end
        HDT.TriggerFromAutoBlock()
    end)
end
hookHDTAnimator()
lp.CharacterAdded:Connect(function()
    task.wait(0.5)
    hookHDTAnimator()
end)

