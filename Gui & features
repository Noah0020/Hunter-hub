-- Defensive helpers: one bad element can't kill a tab
local function SafeToggle(tab, cfg) pcall(function() tab:CreateToggle(cfg) end) end
local function SafeSlider(tab, cfg) pcall(function() tab:CreateSlider(cfg) end) end
local function SafeDropdown(tab, cfg) pcall(function() tab:CreateDropdown(cfg) end) end
local function SafeButton(tab, cfg) pcall(function() tab:CreateButton(cfg) end) end
local function SafeKeybind(tab, cfg) pcall(function() tab:CreateKeybind(cfg) end) end
local function SafeSection(tab, name) pcall(function() tab:CreateSection(name) end) end
local function SafeParagraph(tab, cfg) pcall(function() tab:CreateParagraph(cfg) end) end

