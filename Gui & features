-- NOTE: fireBlock no longer chains HDT. HDT only fires on actual block anim.
local function fireBlock()
    local now = tick()
    if now - lastBlockFire < BLOCK_COOLDOWN then return false end
    lastBlockFire = now
    RemoteEvent:FireServer("UseActorAbility", { BLOCK_BUF })
    return true
end

