AZ = {
    AutoQTE = false,
    InfiniteQTE = false,
    qteHooked = false,
}

-- FIXED: pcall-guarded reassignment; removed meaningless hookfunction check
local function azHookQTE()
    if AZ.qteHooked then return true end
    local ok, mod = pcall(function()
        return require(ReplicatedStorage.Assets.Killers.Azure.Config.cl_WorkaroundModules.cl_ConstructQTE)
    end)
    if not ok or type(mod) ~= "table" or type(mod.new) ~= "function" then return false end
    local origNew = mod.new
    local success = pcall(function()
        mod.new = function(...)
            local qte = origNew(...)
            if qte then
                if AZ.InfiniteQTE then
                    pcall(function() qte.FailedAttempts = -math.huge end)
                end
                if AZ.AutoQTE then
                    task.defer(function()
                        task.wait(0.12)
                        if AZ.AutoQTE and qte and type(qte.AddProgress) == "function" then
                            pcall(function() qte:AddProgress(100) end)
                        end
                    end)
                end
            end
            return qte
        end
    end)
    AZ.qteHooked = success
    return success
end

