-- ========== STAM ==========
local StamTab = Window:CreateTab("Stam", ICON)
SafeSection(StamTab, "Sprint Module")
if not Sprinting then
    SafeParagraph(StamTab, {
        Title = "Sprint Module Unavailable",
        Content = "Infinite Stamina requires the Sprinting module. Rejoin if this persists.",
    })
else
    SafeToggle(StamTab, {
        Name = "Infinite Stamina",
        CurrentValue = false, Flag = "InfStam",
        Callback = function(v)
            CFG.InfiniteStamina = v
            if v then startInfiniteStamina() else stopInfiniteStamina() end
        end,
    })
    SafeSlider(StamTab, {
        Name = "Max Stamina", Range = {1, 1000}, Increment = 1,
        CurrentValue = Sprinting.MaxStamina or 100, Flag = "Stam_Max",
        Callback = function(v) if Sprinting then Sprinting.MaxStamina = v end end,
    })
    SafeSlider(StamTab, {
        Name = "Sprint Speed", Range = {1, 40}, Increment = 1,
        CurrentValue = Sprinting.SprintSpeed or 26, Flag = "Stam_Speed",
        Callback = function(v) if Sprinting then Sprinting.SprintSpeed = v end end,
    })
    SafeSlider(StamTab, {
        Name = "Stamina Gain", Range = {1, 200}, Increment = 1,
        CurrentValue = Sprinting.StaminaGain or 20, Flag = "Stam_Gain",
        Callback = function(v) if Sprinting then Sprinting.StaminaGain = v end end,
    })
    SafeSlider(StamTab, {
        Name = "Stamina Loss", Range = {0, 50}, Increment = 0.5,
        CurrentValue = Sprinting.StaminaLoss or 10, Flag = "Stam_Loss",
        Callback = function(v) if Sprinting then Sprinting.StaminaLoss = v end end,
    })
end

