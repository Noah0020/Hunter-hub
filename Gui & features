local hookedSounds = {}

local function onSoundTrigger(sound)
    if not CFG.AutoBlockEnabled or not CFG.SoundTrigger then return end
    local id = extractSoundId(sound)
    if not id or not TRIGGER_SOUNDS[id] then return end
    local killerRoot = soundToKillerRoot(sound)
    if not killerRoot then return end
    if not shouldBlock(killerRoot) then return end
    if not isBlockAbilityAvailable() then return end
    if CFG.BlockDelay > 0 then task.delay(CFG.BlockDelay, fireBlock) else fireBlock() end
end

local function hookSound(sound)
    if hookedSounds[sound] then return end
    hookedSounds[sound] = true
    sound.Played:Connect(function() onSoundTrigger(sound) end)
    sound:GetPropertyChangedSignal("IsPlaying"):Connect(function()
        if sound.IsPlaying then onSoundTrigger(sound) end
    end)
    sound.Destroying:Once(function() hookedSounds[sound] = nil end)
    if sound.IsPlaying then onSoundTrigger(sound) end
end

if KillersFolder then
    for _, d in ipairs(KillersFolder:GetDescendants()) do
        if d:IsA("Sound") then hookSound(d) end
    end
    KillersFolder.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then hookSound(d) end
    end)
end

local hookedAnims = {}

local function onAnimPlayed(killerModel, track)
    if not CFG.AutoBlockEnabled or not CFG.AnimTrigger then return end
    local animId = track.Animation and tostring(track.Animation.AnimationId):match("(%d+)")
    if not animId or not TRIGGER_ANIMS_SET[animId] then return end
    local killerRoot = killerModel:FindFirstChild("HumanoidRootPart")
    if not killerRoot then return end
    if not shouldBlock(killerRoot) then return end
    if not isBlockAbilityAvailable() then return end
    if CFG.BlockDelay > 0 then task.delay(CFG.BlockDelay, fireBlock) else fireBlock() end
end

local function hookKiller(killerModel)
    if not killerModel:IsA("Model") or hookedAnims[killerModel] then return end
    local humanoid = killerModel:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then return end
    hookedAnims[killerModel] = true
    animator.AnimationPlayed:Connect(function(track) onAnimPlayed(killerModel, track) end)
    killerModel.Destroying:Once(function() hookedAnims[killerModel] = nil end)
end

if KillersFolder then
    for _, k in ipairs(KillersFolder:GetChildren()) do hookKiller(k) end
    KillersFolder.ChildAdded:Connect(hookKiller)
end

