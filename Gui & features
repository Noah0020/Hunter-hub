local function nearestKillerPart()
    local myRoot = getMyRoot()
    if not myRoot or not KillersFolder then return nil end
    local best, bestDist = nil, math.huge
    for _, k in ipairs(KillersFolder:GetChildren()) do
        if k:IsA("Model") then
            local hrp = k:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < bestDist then best, bestDist = hrp, d end
            end
        end
    end
    return best
end

local function startDrag(targetPart)
    if HDT._dragging then return end
    if not targetPart or not targetPart.Parent then return end
    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    HDT._dragging = true
    local saved = {
        walk          = humanoid.WalkSpeed,
        jump          = humanoid.JumpPower,
        platformStand = humanoid.PlatformStand,
        autoRotate    = humanoid.AutoRotate,
    }
    HDT._saved = saved

    humanoid.WalkSpeed     = 0
    humanoid.JumpPower     = 0
    humanoid.PlatformStand = false
    humanoid.AutoRotate    = false

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(100000, 0, 100000)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp
    HDT._bv = bv

    HDT._conn = RunService.Heartbeat:Connect(function()
        if not HDT._dragging or not (char and char.Parent and targetPart and targetPart.Parent) then
            if HDT._conn then HDT._conn:Disconnect() HDT._conn = nil end
            if bv and bv.Parent then bv:Destroy() end
            if humanoid and humanoid.Parent then
                humanoid.WalkSpeed     = saved.walk
                humanoid.JumpPower     = saved.jump
                humanoid.PlatformStand = saved.platformStand
                humanoid.AutoRotate    = saved.autoRotate
            end
            HDT._bv = nil
            HDT._saved = nil
            HDT._dragging = false
            return
        end
        local myPos = hrp.Position
        local tgtPos = targetPart.Position
        local dx = tgtPos.X - myPos.X
        local dz = tgtPos.Z - myPos.Z
        local horizSq = dx*dx + dz*dz
        if horizSq > 1.0E-4 then
            local dist = math.sqrt(horizSq)
            bv.Velocity = Vector3.new((dx / dist) * HDT.Speed, 0, (dz / dist) * HDT.Speed)
            hrp.CFrame = CFrame.lookAt(myPos, Vector3.new(tgtPos.X, myPos.Y, tgtPos.Z))
        else
            bv.Velocity = Vector3.zero
        end
        if (tgtPos - myPos).Magnitude <= HDT.StopDistance then
            HDT._dragging = false
        end
    end)

    task.delay(HDT.SafetyTimeout, function() HDT._dragging = false end)
end

function HDT.TriggerFromAutoBlock()
    if not HDT.Enabled then return end
    if tick() - HDT._lastFire < HDT._fireDebounce then return end
    if HDT._dragging then return end
    HDT._lastFire = tick()
    local target = nearestKillerPart()
    if not target then return end
    if HDT.Delay > 0 then
        task.delay(HDT.Delay, function() startDrag(target) end)
    else
        startDrag(target)
    end
end
HDT.Trigger = HDT.TriggerFromAutoBlock

lp.CharacterAdded:Connect(function()
    HDT._dragging = false
    if HDT._conn then HDT._conn:Disconnect() HDT._conn = nil end
    if HDT._bv and HDT._bv.Parent then HDT._bv:Destroy() end
    HDT._bv = nil
    HDT._saved = nil
end)

