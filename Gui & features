-- Noli
local Noli = {
    Enabled = false, AutoTarget = false, AntiCrash = false,
    DashSpeed = 60, ControlStrength = 1, AutoNova = false,
    BindName = "HH_NoliRush", NovaConn = nil, lastNova = 0,
    chargingStarted = false, dashingStarted = false, currentDir = nil,
}

local function noliVecToDir(vec)
    if not vec then return nil end
    local flat = Vector3.new(vec.X, 0, vec.Z)
    if flat.Magnitude < 0.001 then return nil end
    return flat.Unit
end

local function noliAngleBetween(a, b)
    if not a or not b then return math.pi end
    return math.acos(math.clamp(a:Dot(b), -1, 1))
end

local function noliSmoothDir(oldDir, newDir, dt, strength)
    if not oldDir then return newDir end
    if not newDir then return oldDir end
    local alpha = math.clamp(math.max(0.0001, dt) * 60 * strength, 0, 1)
    return oldDir:Lerp(newDir, alpha).Unit
end

local function noliSetCameraTo(dir)
    if not dir then return end
    if noliAngleBetween(Camera.CFrame.LookVector, dir) > 0.6 then
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, Camera.CFrame.Position + dir)
    end
end

local function noliFindNearest(hrp, selfChar, maxDist)
    local best, bestD = nil, maxDist or math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character ~= selfChar then
            local pHrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            local pHum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            if pHrp and pHum and pHum.Health > 0 then
                local d = (pHrp.Position - hrp.Position).Magnitude
                if d < bestD then bestD = d best = p end
            end
        end
    end
    return best
end

local function noliRushLoop(dt)
    local char = lp.Character
    if not char or char.Name ~= "Noli" then
        if Noli.dashingStarted then
            Noli.dashingStarted = false
            Noli.currentDir = nil
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum.AutoRotate = true hum.WalkSpeed = 16 end
        end
        return
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return end
    local rushState = char:GetAttribute("VoidRushState")
    if rushState ~= "Charging" and rushState ~= "Dashing" then
        if Noli.dashingStarted then
            Noli.dashingStarted = false
            Noli.currentDir = nil
            hum.AutoRotate = true
            hum.WalkSpeed = 16
        end
        return
    end
    if rushState == "Charging" then
        if not Noli.chargingStarted then
            Noli.chargingStarted = true
            Noli.dashingStarted = false
            Noli.currentDir = nil
        end
        if Noli.AutoTarget then
            local nearest = noliFindNearest(hrp, char, 200)
            if nearest and nearest.Character then
                local tHrp = nearest.Character:FindFirstChild("HumanoidRootPart")
                if tHrp then
                    local dir = noliVecToDir(tHrp.Position - hrp.Position)
                    Noli.currentDir = noliSmoothDir(Noli.currentDir, dir, dt, Noli.ControlStrength)
                    noliSetCameraTo(Noli.currentDir)
                    hum:Move(Noli.currentDir)
                end
            end
        end
    elseif rushState == "Dashing" then
        if not Noli.dashingStarted then
            Noli.dashingStarted = true
            hum.AutoRotate = false
            if Noli.Enabled then hum.WalkSpeed = Noli.DashSpeed end
            Noli.currentDir = noliVecToDir(hrp.CFrame.LookVector)
        end
        local desired
        if Noli.AutoTarget then
            local nearest = noliFindNearest(hrp, char, 200)
            if nearest and nearest.Character then
                local tHrp = nearest.Character:FindFirstChild("HumanoidRootPart")
                if tHrp then desired = noliVecToDir(tHrp.Position - hrp.Position) end
            end
        elseif Noli.Enabled then
            desired = noliVecToDir(Camera.CFrame.LookVector)
        end
        if desired then
            local strength = Noli.Enabled and 1 or (Noli.AutoTarget and 0.5 or 1)
            Noli.currentDir = noliSmoothDir(Noli.currentDir, desired, dt, strength)
        end
        if Noli.currentDir then
            if noliAngleBetween(hrp.CFrame.LookVector, Noli.currentDir) > 0.6 then
                hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + Noli.currentDir)
            end
            local vel = Noli.currentDir * Noli.DashSpeed
            hrp.AssemblyLinearVelocity = Vector3.new(vel.X, hrp.AssemblyLinearVelocity.Y, vel.Z)
            for _, c in ipairs(hrp:GetChildren()) do
                if c:IsA("BodyVelocity") then c.Velocity = vel
                elseif c:IsA("LinearVelocity") then c.VectorVelocity = vel end
            end
            hum:Move(Noli.currentDir)
            if Noli.AutoTarget then noliSetCameraTo(Noli.currentDir) end
        end
    end
end

local function noliEnable()
    pcall(function() RunService:UnbindFromRenderStep(Noli.BindName) end)
    RunService:BindToRenderStep(Noli.BindName, Enum.RenderPriority.Camera.Value + 2, noliRushLoop)
end

local function noliDisable()
    pcall(function() RunService:UnbindFromRenderStep(Noli.BindName) end)
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.AutoRotate = true hum.WalkSpeed = 16 end
    Noli.dashingStarted = false
    Noli.chargingStarted = false
    Noli.currentDir = nil
end

local function noliUpdate()
    if Noli.Enabled or Noli.AutoTarget then noliEnable() else noliDisable() end
end

local function noliSetAntiCrash(on)
    Noli.AntiCrash = on
    if not on then return end
    if _G.__HH_noliHooked or not hookmetamethod then return end
    _G.__HH_noliHooked = true
    local ok, mt = pcall(getrawmetatable, game)
    if not ok or not mt then return end
    local old = mt.__namecall
