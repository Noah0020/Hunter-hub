        if not AUTOGEN.Enabled then continue end
        if tick() < AUTOGEN._nextFire then continue end

        local gens = findNearbyGenerators()
        if #gens == 0 then continue end

        AUTOGEN._nextFire = tick() + AUTOGEN.Cooldown
        for _, g in ipairs(gens) do
