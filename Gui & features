-- John Doe
local JD = {
    Enabled = false, SpinAim = false, SpinSpeed = 20,
    DoubleStrike = false, DoubleStrikeSpeed = 25, DoubleStrikeWidth = 20,
    CorruptLeadTime = 0.5, CorruptPostWindup = 2.5,
    VelocitySmooth = 0.15, AimSmoothness = 0.15,
    HooksInstalled = false, CurrentTarget = nil, AimEndTime = 0,
    VelocityTable = {}, AimLoop = nil, VelocityLoop = nil,
}

local function jdTrackVelocity(tableRef, char, hrp, dt, smooth)
    if not hrp then tableRef[char] = nil return end
    local pos = hrp.Position
    local rec = tableRef[char]
    if not rec then
        tableRef[char] = { LastPos = pos, SmoothedVel = Vector3.zero }
    else
        rec.SmoothedVel = rec.SmoothedVel:Lerp((pos - rec.LastPos) / dt, smooth)
        rec.LastPos = pos
    end
end

local function jdStopAim()
    if JD.AimLoop then JD.AimLoop:Disconnect() JD.AimLoop = nil end
    JD.CurrentTarget = nil
end

local function jdGetTargetPosition(char)
    if not char then return Vector3.zero end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return Vector3.zero end
    local rec = JD.VelocityTable[char]
    local vel = rec and rec.SmoothedVel or hrp.AssemblyLinearVelocity
    if vel.Magnitude < 2 then return hrp.Position end
    return hrp.Position + vel * JD.CorruptLeadTime
end

local function jdAimLoop()
    if not JD.Enabled or not JD.CurrentTarget then jdStopAim() return end
    if tick() > JD.AimEndTime then jdStopAim() return end
    local targetHrp = JD.CurrentTarget:FindFirstChild("HumanoidRootPart")
    if not targetHrp then jdStopAim() return end
    local pos = jdGetTargetPosition(JD.CurrentTarget)
    if pos == Vector3.zero then return end
    local myHrp = getRoot(lp.Character)
    if not myHrp then return end
    local flat = Vector3.new(pos.X - myHrp.Position.X, 0, pos.Z - myHrp.Position.Z)
    if flat.Magnitude < 0.05 then return end
    local aimPoint = pos
    if JD.DoubleStrike then
        local look = (pos - myHrp.Position).Unit
        aimPoint = pos + CFrame.lookAt(Vector3.zero, look).RightVector
            * (math.sin(tick() * JD.DoubleStrikeSpeed) * JD.DoubleStrikeWidth)
    end
    local remaining = JD.AimEndTime - tick()
    local targetCF = CFrame.lookAt(myHrp.Position, Vector3.new(aimPoint.X, myHrp.Position.Y, aimPoint.Z))
    if JD.SpinAim and remaining > 0.15 then
        myHrp.CFrame = myHrp.CFrame * CFrame.Angles(0, math.rad(JD.SpinSpeed), 0)
    else
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, pos), 0.2)
        myHrp.CFrame = myHrp.CFrame:Lerp(targetCF, JD.AimSmoothness)
    end
end

local function jdInstallHooks()
    if JD.HooksInstalled then return end
    local ok, behavior = pcall(function()
        return require(ReplicatedStorage.Assets.Killers.JohnDoe.Behavior)
    end)
    if not ok or type(behavior) ~= "table" then return end
    local target = behavior.Abilities and behavior.Abilities.CorruptEnergy
    if type(target) ~= "table" or type(target.Callback) ~= "function" then return end
    local original = target.Callback
    target.Callback = function(...)
        task.spawn(function()
            if not JD.Enabled then return end
            local survivors = workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild("Survivors")
            if not survivors then return end
            local myRoot = getRoot(lp.Character)
            if not myRoot then return end
            local best, bestD = nil, math.huge
            for _, s in ipairs(survivors:GetChildren()) do
                local hrp = s:FindFirstChild("HumanoidRootPart")
                local hum = s:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local d = (hrp.Position - myRoot.Position).Magnitude
                    if d < bestD then bestD = d best = s end
                end
            end
            if not best then return end
            JD.CurrentTarget = best
            JD.AimEndTime = tick() + 0.7 + JD.CorruptPostWindup
            if not JD.AimLoop then JD.AimLoop = RunService.RenderStepped:Connect(jdAimLoop) end
        end)
        return original(...)
    end
    JD.HooksInstalled = true
end

local function jdSetEnabled(enabled)
    JD.Enabled = enabled
    if enabled then
        if not JD.VelocityLoop then
            JD.VelocityLoop = RunService.Heartbeat:Connect(function(dt)
                local survivors = workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild("Survivors")
                if not survivors then return end
                for _, s in ipairs(survivors:GetChildren()) do
                    jdTrackVelocity(JD.VelocityTable, s, s:FindFirstChild("HumanoidRootPart"), dt, JD.VelocitySmooth)
                end
            end)
        end
        task.spawn(jdInstallHooks)
    else
        if JD.VelocityLoop then JD.VelocityLoop:Disconnect() JD.VelocityLoop = nil end
        jdStopAim()
        JD.VelocityTable = {}
    end
end

