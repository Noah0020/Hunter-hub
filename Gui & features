                    if os.clock() - Noli.lastNova > 0.1 then
                        Noli.lastNova = os.clock()
                        RemoteEvent:FireServer("UseActorAbility", { NOVA_BUF })
                    end
                    break
                end
            end
        end
    end)
end

-- Azure
local AZ = { AutoQTE = false, InfiniteQTE = false, GrabAim = false, GolemAim = false, GrabLead = 0.03, GrabSmooth = 0.3, qteHooked = false, grabConn = nil, golemConn = nil }

local function azHookQTE()
    if AZ.qteHooked then return true end
    if type(hookfunction) ~= "function" then return false end
    local ok, mod = pcall(function()
        return require(ReplicatedStorage.Assets.Killers.Azure.Config.cl_WorkaroundModules.cl_ConstructQTE)
    end)
    if not ok or type(mod) ~= "table" or type(mod.new) ~= "function" then return false end
    local origNew = mod.new
    mod.new = function(...)
        local qte = origNew(...)
        if qte then
            if AZ.InfiniteQTE then pcall(function() qte.FailedAttempts = -math.huge end) end
            if AZ.AutoQTE then
                task.defer(function()
                    task.wait(0.12)
                    if AZ.AutoQTE and qte and type(qte.AddProgress) == "function" then
                        pcall(function() qte:AddProgress(100) end)
                    end
                end)
            end
        end
        return qte
    end
    AZ.qteHooked = true
    return true
end

local function azNearestSurvivor(hrp)
    local survivors = workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild("Survivors")
    if not survivors then return nil end
    local best, bestD = nil, math.huge
    for _, s in ipairs(survivors:GetChildren()) do
        local sHrp = s:FindFirstChild("HumanoidRootPart")
        local hum = s:FindFirstChildOfClass("Humanoid")
        if sHrp and hum and hum.Health > 0 then
            local d = (sHrp.Position - hrp.Position).Magnitude
            if d < bestD then bestD = d best = sHrp end
        end
    end
    return best
end

local function azSetGrabAim(on)
    AZ.GrabAim = on
    if AZ.grabConn then AZ.grabConn:Disconnect() AZ.grabConn = nil end
    if not on then return end
    AZ.grabConn = RunService.RenderStepped:Connect(function()
        local char = lp.Character
        if not char or char.Name ~= "Azure" then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local best = azNearestSurvivor(hrp)
        if not best then return end
        local vel = best.AssemblyLinearVelocity or Vector3.zero
        local aimPos = best.Position + vel * AZ.GrabLead
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, aimPos), AZ.GrabSmooth)
        hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(aimPos.X, hrp.Position.Y, aimPos.Z))
    end)
end

local function azSetGolemAim(on)
    AZ.GolemAim = on
    if AZ.golemConn then AZ.golemConn:Disconnect() AZ.golemConn = nil end
    if not on then return end
    AZ.golemConn = RunService.RenderStepped:Connect(function()
        local char = lp.Character
        if not char or char.Name ~= "Azure" then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local best = azNearestSurvivor(hrp)
        if not best then return end
        local aimPos = Vector3.new(best.Position.X, hrp.Position.Y, best.Position.Z)
        hrp.CFrame = CFrame.new(hrp.Position, aimPos)
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, best.Position), 0.15)
    end)
end

