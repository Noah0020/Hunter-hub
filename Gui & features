local function noliSetAutoNova(on)
    Noli.AutoNova = on
    if Noli.NovaConn then Noli.NovaConn:Disconnect() Noli.NovaConn = nil end
    if not on then return end
    pcall(function() require(ReplicatedStorage.Systems.Player.Game.ProjectileReplication) end)
