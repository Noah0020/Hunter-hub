                if type(name) == "string"
                    and (string.find(string.lower(name), "nova")
                      or string.find(string.lower(name), "star")
                      or string.find(string.lower(name), "void"))
                then
                    if os.clock() - noliState.lastNova > 0.1 then
                        noliState.lastNova = os.clock()
                        RemoteEvent:FireServer("UseActorAbility", { NOVA_BUF })
                    end
                    break
                end
            end
        end
    end)
end

