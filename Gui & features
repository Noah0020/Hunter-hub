local function pushIdsFromValue(value, intoSet, abilityName)
    if type(value) == "string" or type(value) == "number" then
        local id = tostring(value):match("%d+")
        if id and not intoSet[id] then intoSet[id] = abilityName end
    elseif type(value) == "table" then
        for _, v in pairs(value) do
            pushIdsFromValue(v, intoSet, abilityName)
        end
    end
end

local function readConfigAnimations(module)
    local ok, cfg = pcall(require, module)
    if not ok or type(cfg) ~= "table" then return end

    if type(cfg.Animations) == "table" then
        for key, value in pairs(cfg.Animations) do
            if ABILITY_ANIM_KEYS[key] then
                pushIdsFromValue(value, AIM.AnimIds, key)
            end
        end
    end

    for _, field in ipairs(SOUND_FIELDS) do
        local soundTable = cfg[field]
        if type(soundTable) == "table" then
            for key, value in pairs(soundTable) do
                if ABILITY_SOUND_KEYS[key] then
                    pushIdsFromValue(value, AIM.SoundIds, key)
                end
            end
        end
    end
end

local function loadMyAbilityIds(char)
    AIM.AnimIds  = {}
    AIM.SoundIds = {}
    if not Assets or not char then return end

    local charName = char:GetAttribute("CharacterName") or char.Name
    local skinName = char:GetAttribute("SkinName") or "Default"

    local survivorsFolder = Assets:FindFirstChild("Survivors")
    local survivorFolder  = survivorsFolder and survivorsFolder:FindFirstChild(charName)
    if survivorFolder then
        local baseCfg = survivorFolder:FindFirstChild("Config")
        if baseCfg then readConfigAnimations(baseCfg) end
    end

    if skinName and skinName ~= "Default" then
        local skinsRoot  = Assets:FindFirstChild("Skins")
        local skinsSurv  = skinsRoot and skinsRoot:FindFirstChild("Survivors")
        local skinChar   = skinsSurv and skinsSurv:FindFirstChild(charName)
        local skinFolder = skinChar and skinChar:FindFirstChild(skinName)
        if skinFolder then
            local skinCfg = skinFolder:FindFirstChild("Config")
            if skinCfg then readConfigAnimations(skinCfg) end
        end
    end
end

