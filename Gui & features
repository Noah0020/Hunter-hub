local function getAimPart(model)
    if not model then return nil end
    local p
    if AIM.Part == "Head" then p = model:FindFirstChild("Head")
    elseif AIM.Part == "Torso" then p = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") end
    return p or model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
end

local function getAimFolder()
    if AIM.TargetType == "Survivors" then return SurvivorsFolder end
    return KillersFolder
end

local function pickTarget()
    local myRoot = getMyRoot()
    if not myRoot then return nil end
    local folder = getAimFolder()
    if not folder then return nil end
    local screenCenter = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.5)
    local best, bestScore = nil, math.huge
    for _, model in ipairs(folder:GetChildren()) do
        if model:IsA("Model") and model ~= lp.Character then
            local hrp = model:FindFirstChild("HumanoidRootPart")
            local hum = model:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local dist = (hrp.Position - myRoot.Position).Magnitude
                if dist <= AIM.Distance then
                    local part = getAimPart(model)
                    if part then
                        local sp, onScreen, depth = Camera:WorldToViewportPoint(part.Position)
                        if onScreen and depth > 0 then
                            local score = (Vector2.new(sp.X, sp.Y) - screenCenter).Magnitude
                            if score < bestScore then
                                if not AIM.WallCheck or losTo(part.Position, model) then
                                    bestScore = score
                                    best = { model = model, part = part }
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local velocityCache = setmetatable({}, { __mode = "k" })
local function predictPos(model, part)
    if AIM.Prediction <= 0 then return part.Position end
    local hrp = model:FindFirstChild("HumanoidRootPart")
    if not hrp then return part.Position end
    local vel = hrp.AssemblyLinearVelocity
    if vel.Magnitude > 120 then vel = Vector3.zero end
    local cached = velocityCache[model]
    if cached then vel = cached:Lerp(vel, 0.35) end
    velocityCache[model] = vel
    return part.Position + vel * AIM.Prediction
end

local aimAccum = 0
RunService.Heartbeat:Connect(function(dt)
    if not AIM.Enabled then return end
    if AIM.PunchOnly and tick() > AIM._punchUntil then return end
    aimAccum = aimAccum + dt
    if aimAccum < 1/60 then return end
    local step = aimAccum
    aimAccum = 0
    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    local target = pickTarget()
    if not target then AIM._currentTarget = nil return end
    AIM._currentTarget = target.model
    local aimPos = predictPos(target.model, target.part)
    local alpha = math.clamp(step / math.max(AIM.Smoothness, 0.02), 0.02, 1)
    if AIM.Method == "Camera Lock" or AIM.Method == "HRP + Camera Lock" then
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, aimPos), alpha)
    end
    if AIM.Method == "HRP Lock" or AIM.Method == "HRP + Camera Lock" then
        local flat = Vector3.new(aimPos.X, hrp.Position.Y, aimPos.Z)
        local delta = flat - hrp.Position
        if delta.Magnitude > 0.01 then
            hrp.CFrame = hrp.CFrame:Lerp(CFrame.lookAt(hrp.Position, hrp.Position + delta.Unit), alpha)
        end
    end
end)

