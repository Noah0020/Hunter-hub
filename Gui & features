local function pushEvent(abilityName)
    AIM.EventRefCount += 1
    AIM.EventActive = true
    AIM.CurrentAbility = abilityName
    if AIM.Debug then
        print("[HA] event start: " .. tostring(abilityName))
    end
end

local function popEvent()
    AIM.EventRefCount = math.max(0, AIM.EventRefCount - 1)
    if AIM.EventRefCount == 0 then
        AIM.EventActive = false
        AIM.CurrentAbility = nil
    end
end

local function attachAnimWatcher(char)
    if AIM.AnimConn then
        pcall(function() AIM.AnimConn:Disconnect() end)
        AIM.AnimConn = nil
    end
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    local animator = hum:WaitForChild("Animator", 5)
    if not animator then return end

    AIM.AnimConn = animator.AnimationPlayed:Connect(function(track)
        local anim = track.Animation
        if not anim then return end
        local animId = tostring(anim.AnimationId):match("%d+")
        if not animId then return end
        if AIM.Debug then print("[HA anim]", animId) end

        local abilityName = AIM.AnimIds[animId]
        if not abilityName then return end

        pushEvent(abilityName)
        local ended = false
        local function finish()
            if ended then return end
            ended = true
            popEvent()
        end
        track.Stopped:Once(finish)
        local dur = track.Length
        if not dur or dur <= 0 then dur = 0.5 end
        task.delay(dur + 0.2, finish)
    end)
